includeConfig 'conf/resources.config'
includeConfig 'conf/process.config'

manifest {
    name            = 'imprint'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}

params {
    samplesheet = null
    outdir      = 'imprint_outs'
    cohort_name = 'cohort'
    extras      = null     // comma-separated: hla,kir,pathseq,mixcr,telseq

    // Mode and capture settings come from the profiles in conf/probekits.config.
    genome               = false
    skip_bqsr            = true
    off_target           = false
    kit_name             = null
    intervals_bed        = null
    bait_intervals       = null
    target_intervals     = null
    padded_intervals_bed = null

    filter_soft_clips    = null   // null autodetects short inserts per sample
    wes_scatter_count    = 20
    genome_scatter_count = 50

    // 2500 for patterned flow cells (NovaSeq, HiSeq 4000/X); 100 for unpatterned
    // ones (HiSeq 2500, MiSeq, NextSeq 550), or PCR duplicates count as optical.
    optical_dup_dist = 2500
    // 8 removes inline xGen UMIs in bulk mode; duplicates are then marked by position.
    trim_front       = 0

    // DupCaller defaults mirror the pinned CLI.
    dupcaller                        = false
    dupcaller_umi_allowlist          = "${projectDir}/assets/umi_allowlists/xgen_8bp_umi32.txt"
    dupcaller_regions                = 'chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chr20 chr21 chr22 chrX'
    dupcaller_max_af                 = 1.0
    dupcaller_germline_af_cutoff     = 0.001
    dupcaller_min_normal_depth       = 10
    // null: 0.5 with noise masks, DupCaller's recommended 0.1 without.
    dupcaller_max_zero_qual_fraction = null
    dupcaller_rescue                 = true
    dupcaller_trim_template          = 7
    dupcaller_trim_read              = 7
    dupcaller_mapq                   = 40
    dupcaller_window_size            = 100000
    // null lets DupCaller pick one and log it; set it to reproduce a run.
    dupcaller_seed                   = null

    multiqc_config            = "${projectDir}/assets/multiqc_config.yaml"
    // Chosen per pair from Somalier's sex call; UNKNOWN uses xx.
    varlociraptor_scenario_xx = "${projectDir}/assets/varlociraptor_scenario_xx.yaml"
    varlociraptor_scenario_xy = "${projectDir}/assets/varlociraptor_scenario_xy.yaml"
    mixcr_license             = "${System.getProperty('user.home')}/.mi.license"
}

includeConfig 'conf/probekits.config'
