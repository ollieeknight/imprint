includeConfig 'conf/resources.config'
includeConfig 'conf/process.config'

manifest {
    name            = 'imprint'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '2.0.0'
}

params {

    samplesheet = null
    outdir      = 'imprint_outs'
    cohort_name = 'cohort'

    genome    = false
    skip_bqsr = true     // wes default; wgs profile overrides to false

    intervals_bed        = null  // set by kit profile
    bait_intervals       = null
    target_intervals     = null
    padded_intervals_bed = null
    kit_name             = null

    // off-target calling; wes-only; kit profiles enable it by default
    off_target = false

    // mutect2 read handling
    filter_soft_clips    = null   // null = autodetect per sample; true/false = force

    // scatter-gather (per-mode)
    wes_scatter_count    = 20     // WES: 20 shards for Mutect2
    genome_scatter_count = 50     // WGS: 50 shards for Mutect2

    // sequencing chemistry
    dupcaller        = false     // xGen UDSeq raw-family calling
    // Optical duplicate distance: 2500 for patterned flow cells (NovaSeq,
    // HiSeq 4000/X); use 100 for unpatterned instruments (HiSeq 2500, MiSeq,
    // NextSeq 550) to avoid counting PCR duplicates as optical duplicates.
    optical_dup_dist = 2500

    // Trim this many bases from the 5' end of both reads in bulk mode.
    // A value of 8 removes inline xGen UMIs; duplicate marking then uses position.
    trim_front = 0

    // DupCaller defaults mirror the pinned CLI.
    dupcaller_umi_allowlist           = "${projectDir}/assets/umi_allowlists/xgen_8bp_umi32.txt"
    dupcaller_regions                 = 'chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chr20 chr21 chr22 chrX'
    dupcaller_max_af                  = 1.0
    dupcaller_germline_af_cutoff      = 0.001
    dupcaller_min_normal_depth        = 10
    // null selects 0.5 with noise masks and DupCaller's recommended 0.1 without.
    dupcaller_max_zero_qual_fraction  = null
    dupcaller_rescue                  = true
    dupcaller_trim_template           = 7
    dupcaller_trim_read               = 7
    dupcaller_mapq                    = 40
    dupcaller_window_size             = 100000
    // Monte Carlo seed for detection-power simulation. null lets DupCaller draw one
    // and record it in the call params log; set it to reproduce a previous run.
    dupcaller_seed                    = null

    // optional features
    multiqc_config = "${projectDir}/assets/multiqc_config.yaml"

    // varlociraptor scenario, picked per pair by somalier sex (UNKNOWN falls back to xx)
    varlociraptor_scenario_xx = "${projectDir}/assets/varlociraptor_scenario_xx.yaml"
    varlociraptor_scenario_xy = "${projectDir}/assets/varlociraptor_scenario_xy.yaml"

    extras = null     // --extras hla,kir,pathseq,mixcr,telseq

    mixcr_license = "${System.getProperty('user.home')}/.mi.license"  // MiXCR licence path

}

includeConfig 'conf/probekits.config'
