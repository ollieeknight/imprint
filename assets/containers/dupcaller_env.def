Bootstrap: docker
From: python:3.12-slim

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        gcc \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libhdf5-dev \
        tabix
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir git+https://github.com/AlexandrovLab/DupCaller

%environment
    export MPLCONFIGDIR=/tmp
    export HOME=/tmp
    export SIGPROFILERPLOTTING_VOLUME=/tmp/sigprofilerplotting

%runscript
    exec "$@"

%test
    python -c 'import DupCaller_sub'
    DupCaller.py call --help > /dev/null
    DupCaller.py estimate --help > /dev/null
    DupCaller.py summarize --help > /dev/null
    DupCaller.py index --help > /dev/null
    DupCaller.py index-dbs --help > /dev/null
    bgzip --version | head -1
    tabix --version | head -1
