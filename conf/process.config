// Optional extras retry, then give up without cancelling core outputs.
process {
    withName: 'CHARACTERISATION:.*' {
        maxRetries    = 1
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
    }
    withName: 'CHARACTERISATION:KIR_MAPPER' {
        maxRetries    = 2
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    }
}

profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'compute'

        apptainer.envWhitelist = ['APPTAINER_TMPDIR', 'APPTAINER_CACHEDIR', 'http_proxy', 'https_proxy', 'HTTP_PROXY', 'HTTPS_PROXY']
        apptainer.runOptions   = '--bind /charite-store-f/f-cc12-ag-romagnani --bind /sc-projects/sc-proj-cc12-ag-romagnani --bind /sc-scratch/sc-scratch-cc12-ag-romagnani'

        process.clusterOptions = '--exclude=s-sc-node038'   // broken sssd; fails apptainer uid resolution

        process {
            errorStrategy = { task.exitStatus in [130, 137, 140, 143, 247] ? 'retry' : 'finish' }
            maxRetries    = 2

            withLabel: process_single {
                cpus   = 1
                memory = { 4.GB * task.attempt }
                time   = { 2.h * task.attempt }
            }
            withLabel: process_low {
                cpus   = 2
                memory = { 8.GB * task.attempt }
                time   = { 4.h * task.attempt }
            }
            withLabel: process_medium {
                cpus   = 4
                memory = { 16.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel: process_high {
                cpus   = 8
                memory = { 32.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withLabel: process_high_cpu {
                cpus   = 16
                memory = { 64.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }

            // Input-sized tasks set cpus and memory in their modules.
            withName: 'ALIGN:BWA_MEM3_LANE_BULK|ALIGN:SORT_LANE_BULK|ALIGN:DUPCALLER_TRIM_LANE|ALIGN:DUPCALLER_ALIGN_LANE|ALIGN:DUPCALLER_SORT_LANE' {
                time = { 24.h * task.attempt }
            }
            withName: 'ALIGN:DUPCALLER_VALIDATE_.*' {
                memory = { 32.GB * task.attempt }
            }
            // 4 GB per DupCaller worker.
            withName: 'DUPCALLER:DUPCALLER_CALL' {
                cpus   = 32
                memory = { 128.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'SOMATIC_CALLING:MUTECT2:MUTECT2_CALL' {
                memory = { 16.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withName: 'SOMATIC_CALLING:DEEPSOMATIC' {
                queue            = 'gpu'
                clusterOptions   = '--gres=gpu:1'
                containerOptions = '--nv'
                time             = 6.h
            }
            withName: '.*:VEP_ANNOTATE' {
                memory = { 64.GB * task.attempt }
            }
            withName: 'CHARACTERISATION:OPTITYPE_GENOTYPE' {
                memory = 64.GB
            }
            withName: 'CHARACTERISATION:KIR_MAPPER' {
                memory = 128.GB
                time   = 24.h
            }
        }
    }

    wgs {
        process {
            withName: 'ALIGN:BWA_MEM3_LANE_BULK|ALIGN:SORT_LANE_BULK' {
                time = 48.h
            }
            withName: 'ALIGN:FASTP' {
                cpus   = 8
                memory = { 32.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withName: 'ALIGN:MARK_DUPLICATES' {
                cpus   = 16
                memory = { 64.GB * task.attempt }
                time   = { 48.h * task.attempt }
            }
            withName: 'ALIGN:MERGE_TAGGED_BAMS' {
                cpus   = 8
                memory = 16.GB
                time   = 48.h
            }
            withName: 'ALIGN:EXPORT_CRAM' {
                cpus   = 16
                memory = { 32.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'ALIGN:CORRECT_OVERLAPPING_BASES' {
                cpus   = 4
                memory = 64.GB
                time   = 48.h
            }
            withName: 'QC:MOSDEPTH|QC:VERIFYBAMID2|QC:RIKER_QC' {
                cpus   = 8
                memory = 32.GB
                time   = 12.h
            }
            withName: 'SOMATIC_CALLING:MUTECT2:MUTECT2_CALL' {
                cpus   = 4
                memory = 32.GB
                time   = 48.h
            }
            withName: 'SOMATIC_CALLING:MUTECT2:MUTECT2_PILEUP' {
                cpus   = 4
                memory = 16.GB
                time   = 8.h
            }
            withName: 'PON_GENERATION:.*' {
                cpus   = 4
                memory = { 32.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'SOMATIC_CALLING:STRELKA2:MANTA|SOMATIC_CALLING:STRELKA2:STRELKA2_CALL' {
                cpus   = 32
                memory = 128.GB
                time   = 48.h
            }
            withName: 'SOMATIC_CALLING:STRELKA2:MANTA_PREP_BAM' {
                cpus   = 4
                memory = { 16.GB * task.attempt }
                time   = 8.h
            }
            withName: 'ANNOTATION:STRELKA2_MERGE|ANNOTATION:ENSEMBLE_CONSENSUS|ANNOTATION:MARK_ON_TARGET' {
                cpus   = 4
                memory = 8.GB
                time   = 12.h
            }
            withName: 'ANNOTATION:VAFATOR' {
                cpus   = 8
                memory = 32.GB
                time   = 12.h
            }
            withName: 'ANNOTATION:VEP:VEP_ANNOTATE' {
                cpus   = 16
                memory = { 96.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'ANNOTATION:VARLOCIRAPTOR:.*|ANNOTATION:VARLOCIRAPTOR_MERGE' {
                cpus   = 8
                memory = 64.GB
                time   = 24.h
            }
            withName: 'CHARACTERISATION:PATHSEQ' {
                cpus   = 32
                memory = 128.GB
                time   = 24.h
            }
        }
    }
}
