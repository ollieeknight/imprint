// Executor, retries, queues and resource mappings.

profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'compute'

        apptainer.envWhitelist = ['APPTAINER_TMPDIR', 'APPTAINER_CACHEDIR', 'http_proxy', 'https_proxy', 'HTTP_PROXY', 'HTTPS_PROXY']
        apptainer.runOptions   = '--bind /charite-store-f/f-cc12-ag-romagnani --bind /sc-projects/sc-proj-cc12-ag-romagnani --bind /sc-scratch/sc-scratch-cc12-ag-romagnani'

        process.clusterOptions = '--exclude=s-sc-node038'   // broken sssd; fails apptainer uid resolution

        process {
            errorStrategy = { task.exitStatus in [130, 137, 140, 143, 247] ? 'retry' : 'finish' }
            maxRetries    = 2

            // Base resource tiers; input-sized tasks use process_dynamic.
            withLabel: process_single {
                cpus   = 1
                memory = 4.GB
                time   = 2.h
            }
            withLabel: process_low {
                cpus   = 2
                memory = 8.GB
                time   = 4.h
            }
            withLabel: process_medium {
                cpus   = 4
                memory = 16.GB
                time   = 4.h
            }
            withLabel: process_high {
                cpus   = 8
                memory = 32.GB
                time   = 12.h
            }

            // Modifiers apply after tiers.
            withLabel: process_low_memory {
                memory = { 2.GB * task.cpus * task.attempt }
            }
            withLabel: process_high_memory {
                memory = { 8.GB * task.cpus * task.attempt }
            }
            withLabel: process_high_cpu {
                cpus   = 16
                memory = 64.GB
            }
            withLabel: process_very_short {
                time = 1.h
            }
            withLabel: process_short {
                time = 2.h
            }
            withLabel: process_long {
                time = 12.h
            }
            withLabel: process_very_long {
                time = 24.h
            }

            // Dynamic retry scaling
            withName: 'ALIGN:FASTP' {
                cpus          = 4
                memory        = { 16.GB * task.attempt }
                time          = { 4.h * task.attempt }
            }
            withName: 'ALIGN:MARK_DUPLICATES|ALIGN:EXPORT_CRAM' {
                memory = { 16.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withName: 'ALIGN:DUPCALLER_MARK_DUPLICATES|ALIGN:DUPCALLER_VALIDATE_BAM|ALIGN:DUPCALLER_VALIDATE_CRAM' {
                memory = { 32.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            // BWA-MEM3 memory remains in the alignment modules.
            withName: 'ALIGN:DUPCALLER_ALIGN_LANE|ALIGN:DUPCALLER_SORT_LANE' {
                time = { 24.h * task.attempt }
            }
            // Allow 4 GB per DupCaller worker for learning and calling.
            withName: 'DUPCALLER:DUPCALLER_CALL' {
                cpus   = 32
                memory = { 128.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'SOMATIC_CALLING:MUTECT2:CALL' {
                memory = { 16.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withName: 'SOMATIC_CALLING:STRELKA2:MANTA|SOMATIC_CALLING:STRELKA2:CALL' {
                memory = { 64.GB * task.attempt }
            }
            withName: 'SOMATIC_CALLING:DEEPSOMATIC:CALL' {
                queue            = 'gpu'
                clusterOptions   = '--gres=gpu:1'
                containerOptions = '--nv'
                memory           = { 64.GB * task.attempt }
                time             = 6.h
            }
            withName: 'ANNOTATION:VEP_ANNOTATE' {
                memory = { 64.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }

            // Optional analyses may fail without cancelling core outputs
            withName: 'CHARACTERISATION:OPTITYPE_EXTRACT' {
                maxRetries    = 1
                errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
            }
            withName: 'CHARACTERISATION:OPTITYPE_GENOTYPE' {
                memory       = 64.GB
                maxRetries    = 1
                errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
            }
            withName: 'CHARACTERISATION:KIR_MAPPER' {
                memory       = 128.GB
                maxRetries    = 2
                errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
            }
            withName: 'CHARACTERISATION:KIR_COLLATE' {
                maxRetries    = 1
                errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
            }
            withName: 'CHARACTERISATION:PATHSEQ' {
                maxRetries    = 1
                errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
            }
            withName: 'CHARACTERISATION:MIXCR|CHARACTERISATION:MIXCR_EXPORT_CLONES' {
                maxRetries    = 1
                errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
            }
            withName: 'CHARACTERISATION:TELSEQ' {
                maxRetries    = 1
                errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' }
            }
        }
    }

    // wgs resource overrides
    wgs {
        process {

            // alignment
            withName: 'BWA_MEM3_LANE_BULK|SORT_LANE_BULK' {
                time = 48.h
            }
            withName: 'ALIGN:FASTP' {
                cpus   = 8
                memory = { 32.GB * task.attempt }
                time   = { 12.h * task.attempt }
            }
            withName: 'ALIGN:MARK_DUPLICATES' {
                cpus   = 16
                memory = { 64.GB * task.attempt }
                time   = { 48.h * task.attempt }
            }
            withName: 'ALIGN:MERGE_TAGGED_BAMS' {
                cpus   = 8
                memory = 16.GB
                time   = 48.h
            }
            withName: 'ALIGN:EXPORT_CRAM' {
                cpus   = 16
                memory = { 32.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'ALIGN:CORRECT_OVERLAPPING_BASES' {
                cpus   = 4
                memory = 64.GB
                time   = 48.h
            }

            // qc
            withName: 'QC:MOSDEPTH' {
                cpus   = 8
                memory = 32.GB
                time   = 12.h
            }
            withName: 'QC:VERIFYBAMID2' {
                cpus   = 8
                memory = 32.GB
                time   = 12.h
            }
            withName: 'QC:RIKER_QC' {
                cpus   = 8
                memory = 32.GB
                time   = 12.h
            }

            withName: 'SOMATIC_CALLING:MUTECT2:CALL' {
                cpus   = 4
                memory = 32.GB
                time   = 48.h
            }

            // Genome-wide PoN generation without interval splitting.
            withName: 'PON_GENERATION:MUTECT2_NORMAL_ONLY' {
                cpus   = 4
                memory = { 32.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'PON_GENERATION:GENOMICSDB_IMPORT_PON' {
                cpus   = 4
                memory = { 32.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'PON_GENERATION:CREATE_PON' {
                cpus   = 4
                memory = { 32.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'SOMATIC_CALLING:MUTECT2:PILEUP' {
                cpus   = 4
                memory = 16.GB
                time   = 8.h
            }
            withName: 'SOMATIC_CALLING:STRELKA2:MANTA|SOMATIC_CALLING:STRELKA2:CALL' {
                cpus   = 32
                memory = 128.GB
                time   = 48.h
            }
            withName: 'SOMATIC_CALLING:STRELKA2:PREP_MANTA_BAM' {
                cpus   = 4
                memory = { 16.GB * task.attempt }
                time   = 8.h
            }

            // annotation
            withName: 'ANNOTATION:STRELKA2_MERGE|ANNOTATION:ENSEMBLE_CONSENSUS|ANNOTATION:TUMOR_NORMAL_FILTER' {
                cpus   = 4
                memory = 8.GB
                time   = 12.h
            }
            withName: 'ANNOTATION:VAFATOR' {
                cpus   = 8
                memory = 32.GB
                time   = 12.h
            }
            withName: 'ANNOTATION:VEP_ANNOTATE' {
                cpus   = 16
                memory = { 96.GB * task.attempt }
                time   = { 24.h * task.attempt }
            }
            withName: 'ANNOTATION:VARLOCIRAPTOR:VARLOCIRAPTOR_ALIGNMENT_PROPERTIES|ANNOTATION:VARLOCIRAPTOR:VARLOCIRAPTOR_INDEX|ANNOTATION:VARLOCIRAPTOR_MERGE' {
                cpus   = 8
                memory = 64.GB
                time   = 24.h
            }
            withName: 'ANNOTATION:VARLOCIRAPTOR:VARLOCIRAPTOR_PREPROCESS|ANNOTATION:VARLOCIRAPTOR:VARLOCIRAPTOR_CALLVARIANTS' {
                cpus   = 8
                memory = 64.GB
                time   = 24.h
            }

            // characterisation
            withName: 'CHARACTERISATION:PATHSEQ' {
                cpus   = 32
                memory = 128.GB
                time   = 24.h
            }
        }
    }
}
